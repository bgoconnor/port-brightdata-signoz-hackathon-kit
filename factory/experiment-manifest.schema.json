{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-factory.local/schemas/experiment-manifest-v1.json",
  "title": "Paper Factory Experiment Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "arxiv_id",
    "paper_version",
    "selected_claim",
    "scope",
    "sources",
    "environment",
    "experiment",
    "reported_result",
    "comparison"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "arxiv_id": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{4,5}(v[0-9]+)?$" },
    "paper_version": { "type": "string", "minLength": 1 },
    "selected_claim": { "type": "string", "minLength": 20 },
    "scope": {
      "enum": ["full_claim", "partial_claim", "mechanism_demo", "blocked"]
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url", "sha256"],
        "properties": {
          "kind": { "enum": ["paper", "source_code", "dataset", "supplement"] },
          "url": { "type": "string", "format": "uri" },
          "version": { "type": "string" },
          "license": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container_image", "dependency_lock", "network_during_execution"],
      "properties": {
        "container_image": { "type": "string", "minLength": 1 },
        "dependency_lock": { "type": "string", "minLength": 1 },
        "hardware": { "type": "string" },
        "network_during_execution": { "const": false }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "timeout_seconds", "random_seeds", "result_file"],
      "properties": {
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
        "random_seeds": { "type": "array", "items": { "type": "integer" } },
        "result_file": { "type": "string", "pattern": "^[^/].*\\.json$" }
      }
    },
    "reported_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value", "source_location"],
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "value": { "type": ["number", "string"] },
        "unit": { "type": "string" },
        "source_location": { "type": "string", "minLength": 1 }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "tolerance", "rationale"],
      "properties": {
        "method": { "enum": ["absolute", "relative", "interval", "exact"] },
        "tolerance": { "type": ["number", "string"] },
        "rationale": { "type": "string", "minLength": 10 }
      }
    }
  }
}
